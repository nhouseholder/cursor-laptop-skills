{
  "mcpServers": {
    "engram": {
      "command": "bash",
      "args": [
        "./scripts/cloud_engram_mcp.sh",
        "mcp",
        "--tools=agent"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "ENGRAM_CLOUD_AUTOSYNC": "1"
      }
    },
    "tailscale-imac": {
      "command": "python3",
      "args": [
        "./scripts/cloud_tailscale_mcp.py"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
